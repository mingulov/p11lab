diff --git a/lib/ykpiv.c b/lib/ykpiv.c
index b1520f6..30ae6e9 100644
--- a/lib/ykpiv.c
+++ b/lib/ykpiv.c
@@ -1325,7 +1325,9 @@ ykpiv_rc _ykpiv_transfer_data(ykpiv_state *state,
   *out_len = 0;
 
   do {
-    APDU apdu = {templ[0], templ[1], templ[2], templ[3], 0xff};
+    /* Cap chained command blocks at 254 data bytes so case-4S blocks
+     * (5 header + data + 1 Le on T=1) never exceed 260 bytes. */
+    APDU apdu = {templ[0], templ[1], templ[2], templ[3], 0xfe};
     unsigned char data[YKPIV_OBJ_MAX_SIZE] = {0};
 
 
