+#[derive(Clone, Copy)]
+struct SupportedMechanism {
+    mechanism: raw::CK_MECHANISM_TYPE,
+    min_key_size: raw::CK_ULONG,
+    max_key_size: raw::CK_ULONG,
+    flags: raw::CK_FLAGS,
+}
+
+// Keep this list in numeric mechanism order. The key-size units are bits for
+// RSA/EC/generic-secret mechanisms and bytes for AES mechanisms, as specified
+// by CK_MECHANISM_INFO.
+const SUPPORTED_MECHANISMS: [SupportedMechanism; 12] = [
+    SupportedMechanism {
+        mechanism: raw::CKM_RSA_PKCS_KEY_PAIR_GEN,
+        min_key_size: 1024,
+        max_key_size: 8192,
+        flags: raw::CKF_GENERATE_KEY_PAIR,
+    },
+    SupportedMechanism {
+        mechanism: raw::CKM_RSA_PKCS,
+        min_key_size: 1024,
+        max_key_size: 8192,
+        flags: raw::CKF_SIGN | raw::CKF_VERIFY,
+    },
+    SupportedMechanism {
+        mechanism: raw::CKM_SHA256_HMAC,
+        min_key_size: 0,
+        max_key_size: 0,
+        flags: raw::CKF_SIGN | raw::CKF_VERIFY,
+    },
+    SupportedMechanism {
+        mechanism: raw::CKM_GENERIC_SECRET_KEY_GEN,
+        min_key_size: 8,
+        max_key_size: 65536,
+        flags: raw::CKF_GENERATE,
+    },
+    SupportedMechanism {
+        mechanism: raw::CKM_EC_KEY_PAIR_GEN,
+        min_key_size: 256,
+        max_key_size: 256,
+        flags: raw::CKF_GENERATE_KEY_PAIR | raw::CKF_EC_F_P | raw::CKF_EC_NAMEDCURVE | raw::CKF_EC_UNCOMPRESS,
+    },
+    SupportedMechanism {
+        mechanism: raw::CKM_ECDSA,
+        min_key_size: 256,
+        max_key_size: 256,
+        flags: raw::CKF_SIGN | raw::CKF_VERIFY | raw::CKF_EC_F_P | raw::CKF_EC_NAMEDCURVE | raw::CKF_EC_UNCOMPRESS,
+    },
+    SupportedMechanism {
+        mechanism: raw::CKM_AES_KEY_GEN,
+        min_key_size: 16,
+        max_key_size: 32,
+        flags: raw::CKF_GENERATE,
+    },
+    SupportedMechanism {
+        mechanism: raw::CKM_AES_ECB,
+        min_key_size: 16,
+        max_key_size: 32,
+        flags: raw::CKF_ENCRYPT | raw::CKF_DECRYPT,
+    },
+    SupportedMechanism {
+        mechanism: raw::CKM_AES_CBC,
+        min_key_size: 16,
+        max_key_size: 32,
+        flags: raw::CKF_ENCRYPT | raw::CKF_DECRYPT,
+    },
+    SupportedMechanism {
+        mechanism: raw::CKM_AES_CBC_PAD,
+        min_key_size: 16,
+        max_key_size: 32,
+        flags: raw::CKF_ENCRYPT | raw::CKF_DECRYPT,
+    },
+    SupportedMechanism {
+        mechanism: raw::CKM_AES_GCM,
+        min_key_size: 16,
+        max_key_size: 32,
+        flags: raw::CKF_ENCRYPT | raw::CKF_DECRYPT,
+    },
+    SupportedMechanism {
+        mechanism: raw::CKM_AES_KEY_WRAP_PAD,
+        min_key_size: 32,
+        max_key_size: 32,
+        flags: raw::CKF_WRAP | raw::CKF_UNWRAP,
+    },
+];
+
+#[no_mangle]
+/// # Safety
+///
+/// Writes the mechanism IDs and count through caller-provided pointers.
+pub unsafe extern "C" fn C_GetMechanismList(
+    slotID: raw::CK_SLOT_ID,
+    pMechanismList: raw::CK_MECHANISM_TYPE_PTR,
+    pulCount: raw::CK_ULONG_PTR,
+) -> raw::CK_RV {
+    ck("C_GetMechanismList", || {
+        HSM.slot_exists(SlotId(slotID)).ck()?;
+        if pulCount.is_null() {
+            return Err(raw::CKR_ARGUMENTS_BAD);
+        }
+
+        let required = SUPPORTED_MECHANISMS.len() as raw::CK_ULONG;
+        unsafe {
+            if pMechanismList.is_null() {
+                *pulCount = required;
+                return Ok(());
+            }
+            if *pulCount < required {
+                *pulCount = required;
+                return Err(raw::CKR_BUFFER_TOO_SMALL);
+            }
+            for (index, entry) in SUPPORTED_MECHANISMS.iter().enumerate() {
+                *pMechanismList.add(index) = entry.mechanism;
+            }
+            *pulCount = required;
+        }
+        Ok(())
+    })
+}
+
+#[no_mangle]
+/// # Safety
+///
+/// Writes mechanism information through the caller-provided pointer.
+pub unsafe extern "C" fn C_GetMechanismInfo(
+    slotID: raw::CK_SLOT_ID,
+    type_: raw::CK_MECHANISM_TYPE,
+    pInfo: raw::CK_MECHANISM_INFO_PTR,
+) -> raw::CK_RV {
+    ck("C_GetMechanismInfo", || {
+        HSM.slot_exists(SlotId(slotID)).ck()?;
+        if pInfo.is_null() {
+            return Err(raw::CKR_ARGUMENTS_BAD);
+        }
+        let mechanism = SUPPORTED_MECHANISMS
+            .iter()
+            .find(|entry| entry.mechanism == type_)
+            .ok_or(raw::CKR_MECHANISM_INVALID)?;
+        unsafe {
+            *pInfo = raw::CK_MECHANISM_INFO {
+                ulMinKeySize: mechanism.min_key_size,
+                ulMaxKeySize: mechanism.max_key_size,
+                flags: mechanism.flags,
+            };
+        }
+        Ok(())
+    })
+}
+
