+/// P11Lab: read a single-line secret from a file. Rejects oversized,
+/// empty, NUL-bearing and multi-line inputs; strips one trailing LF.
+fn read_secret_file(path: &str) -> Result<String, Box<dyn std::error::Error>> {
+    let bytes = std::fs::read(path).map_err(|e| format!("cannot read secret file: {}", e))?;
+    if bytes.len() > 4096 {
+        return Err("secret file exceeds 4096-byte bound".into());
+    }
+    if bytes.contains(&0) {
+        return Err("secret file contains unsupported bytes".into());
+    }
+    let mut text = String::from_utf8(bytes)
+        .map_err(|_| "secret file is not valid UTF-8".to_string())?;
+    if let Some(stripped) = text.strip_suffix('\n') {
+        text = stripped.to_string();
+    }
+    if let Some(stripped) = text.strip_suffix('\r') {
+        text = stripped.to_string();
+    }
+    if text.is_empty() {
+        return Err("secret file is empty".into());
+    }
+    if text.contains('\n') || text.contains('\r') {
+        return Err("secret file must be a single line".into());
+    }
+    Ok(text)
+}
