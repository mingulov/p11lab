+pub extern "C" fn C_GetInfo(p_info: *mut CK_INFO) -> CK_RV {
+    ffi_guard!({
+        // P11Lab: fill the info struct (previously returned OK without
+        // writing anything). Strings come from upstream's own get_info().
+        if p_info.is_null() {
+            return CKR_ARGUMENTS_BAD;
+        }
+        unsafe {
+            let info = &mut *p_info;
+            info.cryptoki_version = CK_VERSION { major: 2, minor: 40 };
+            pad_copy(&mut info.manufacturer_id, b"softKMS");
+            info.flags = 0;
+            pad_copy(&mut info.library_description, b"softKMS PKCS#11 Provider");
+            info.library_version = CK_VERSION { major: 0, minor: 1 };
+        }
+        CKR_OK
+    })
 }
 
