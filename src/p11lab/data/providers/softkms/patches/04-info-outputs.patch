+#[repr(C)]
+#[derive(Debug)]
+struct CK_INFO {
+    cryptoki_version: CK_VERSION,
+    manufacturer_id: [u8; 32],
+    flags: CK_ULONG,
+    library_description: [u8; 32],
+    library_version: CK_VERSION,
+}
+
+/// Copy `text` into a fixed-width PKCS#11 field, space-padding the rest.
+/// P11Lab: several fixed strings were short, leaving caller memory
+/// uninitialized; padding makes every info byte deterministic.
+fn pad_copy(field: &mut [u8], text: &[u8]) {
+    field.fill(b' ');
+    let n = text.len().min(field.len());
+    field[..n].copy_from_slice(&text[..n]);
+}
+
